# TECHBLITZ Environment Configuration Example

# Flask Secret Key
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Connection (Defaults to SQLite in instance/database.db)
# For PostgreSQL: postgresql://username:password@localhost:5432/techblitz
# For MySQL: mysql+pymysql://username:password@localhost:3306/techblitz
DATABASE_URL=sqlite:///instance/database.db

# Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Server Port
PORT=5050

# Optional AI Question Generator Integration
# Supported providers: template (default, zero-config), openai, gemini
AI_PROVIDER=template
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo
